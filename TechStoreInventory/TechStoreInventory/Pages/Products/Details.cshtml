@page "Details/{id:guid}"
@model TechStoreInventory.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>

<div>
    <h4>Products</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Name</dt>
        <dd class = "col-sm-10">@Model.Products.Name</dd>

        <dt class = "col-sm-2">Description</dt>
        <dd class = "col-sm-10">@Model.Products.Description</dd>

        <dt class = "col-sm-2">Type</dt>
        <dd class = "col-sm-10">@Model.Products.Type</dd>

        <dt class = "col-sm-2">Price</dt>
        <dd class = "col-sm-10">@(Model.Products.Price.HasValue ? Model.Products.Price.Value.ToString("C") : "")</dd>
    </dl>
</div>

<div>
    <a asp-page="Edit" asp-route-id="@Model.Products.Id" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</div>
